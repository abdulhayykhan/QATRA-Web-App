# ==============================================================================
# QATRA — Environment Variables Template (.env.example)
# Copy this file to .env and replace the placeholder values.
# NEVER commit your actual .env file with real secrets!
# ==============================================================================

# --- Application & Server Settings ---
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="QATRA Emergency Blood Response Platform"
VERSION=1.0.0
API_V1_STR=/api
SECRET_KEY=generate-a-secure-random-32-byte-hex-string

# --- Database (Supabase PostgreSQL) ---
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres (Transaction/Session Pooler)
# Or Direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.gwkeawlwusrmhvvhrnkc.supabase.co:5432/postgres
SUPABASE_URL=https://gwkeawlwusrmhvvhrnkc.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Firebase Authentication (Google Sign-In) ---
# Frontend Client Config (Public keys for browser Web SDK)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=qatra-web-app.firebaseapp.com
FIREBASE_PROJECT_ID=qatra-web-app
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id

# Backend Firebase Admin SDK (Private keys for backend token verification)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_LINES_HERE\n-----END PRIVATE KEY-----\n"

# --- Security & Encryption (NFR 2.1) ---
# 32-byte key for AES-256 encryption of sensitive CNIC & health responses
ENCRYPTION_KEY_AES256=your-32-byte-base64-or-hex-encryption-key
